# Build outputs (regenerated by scripts\build-*.bat and scripts\package.bat)
/build/
/out/
/app/wasm/
/app/licenses/
*.o
*.a

# Tizen packaging leftovers
/app/.manifest.tmp
/app/author-signature.xml
/app/signature1.xml
/app/.delta.lst

# Signing material must never be committed
*.p12
*.pri
*.pwd
*.csr
profiles.xml
device-profile.xml

# Test media and tool output
*.hevc
*.h264
*.log

# Editors and OS
.vscode/
.vs/
.idea/
Thumbs.db
.DS_Store

# Sonar scanner work folder
.scannerwork/
